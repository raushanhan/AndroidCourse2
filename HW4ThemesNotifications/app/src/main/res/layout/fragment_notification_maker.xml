<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".fragment.NotificationMakerFragment">

    <androidx.cardview.widget.CardView
        android:id="@+id/iv_card"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="60dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

        <ImageView
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/ImageViewText"
            android:scaleType="centerCrop" />
    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/remove_photo_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="100dp"
        android:contentDescription="@string/remove_photo_content_description"
        android:src="@drawable/baseline_remove_circle_24"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/iv_card"
        app:layout_constraintStart_toStartOf="@id/iv_card"
        />

    <androidx.cardview.widget.CardView
        android:id="@+id/themes_menu_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/CommonMargin"
        app:cardElevation="4dp"
        app:cardCornerRadius="8dp"
        app:layout_constraintTop_toBottomOf="@id/iv_card">

        <LinearLayout
            android:id="@+id/themes_menu_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/show_theme_options_content_desc"
                android:layout_marginStart="360dp"
                android:src="@drawable/baseline_keyboard_double_arrow_down_24" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/themes_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:paddingTop="8dp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/notification_title_text_input_layout"
        style="@style/TextInputLayoutStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:helperText="@string/notification_title_helper_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/themes_menu_card">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/notification_title_text_input_et"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/et_hint" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/notification_text_text_input_layout"
        style="@style/TextInputLayoutStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:helperText="@string/notification_text_helper_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/notification_title_text_input_layout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/notification_text_text_input_et"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/et_hint" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/menu_layout"
        style="@style/DropDownMenuStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxStrokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/notification_text_text_input_layout">

        <AutoCompleteTextView
            android:id="@+id/menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/menu_button_hint"
            android:inputType="none" />

    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/show_notification_button"
        style="@style/ButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/show_notif_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menu_layout" />

    <Button
        android:id="@+id/reset_theme_button"
        style="@style/ButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reset_theme_btn_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/show_notification_button" />

</androidx.constraintlayout.widget.ConstraintLayout>
